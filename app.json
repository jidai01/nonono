{
  "expo": {
    "name": "nonono",
    "slug": "nonono",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nonono",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nonono.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nonono.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "statusBar": {
        "style": "dark",
        "backgroundColor": "#F4F7F6"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3D8B8B"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow nonono to use Face ID for quick login"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1ca6001-5d7e-4440-89c4-d8be3f04ccb2"
      }
    }
  }
}
